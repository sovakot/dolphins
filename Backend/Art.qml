    function find(name) {
        if (typeof name !== "string" || !name) return ""
        if (paths.hasOwnProperty(name)) return name
        const low = name.charAt(0).toLowerCase() + name.slice(1)
        return paths.hasOwnProperty(low) ? low : ""
    }
    function has(name) { return find(name) !== "" }
    function path(name) { return paths[find(name)] ?? "" }
